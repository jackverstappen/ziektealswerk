---
import "../styles/industry.css";
const { titel, omschrijving = "COLLECTIEF ZIEKTE ⇔ WERK" } = Astro.props;
const nav = [
  ["/#over", "Over ons"],
  ["/publicaties", "Publicaties"],
  ["/#nieuws", "Varia"],
  ["/#contact", "Contact"]
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel} — ziekte ⇔ werk</title>
    <meta name="description" content={omschrijving} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:image" content="/og-beeld.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="ziekte ⇔ werk — gesproken versies" href="/luister/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f2f2f3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      body { margin: 0; font-family: var(--font-body); background: var(--color-bg); color: var(--color-text); overflow-x: hidden; }
      a { color: var(--color-accent-700); text-decoration: none; }
      a:hover { color: var(--color-accent-900); text-decoration: underline; }
      ::-webkit-scrollbar { height: 6px; width: 6px; }
      ::-webkit-scrollbar-thumb { background: var(--color-accent-400); }

      .balk { position: sticky; top: 0; z-index: 40; display: flex; align-items: center;
        justify-content: space-between; gap: 24px; padding: 14px clamp(16px, 4vw, 32px);
        background: color-mix(in srgb, var(--color-bg) 88%, transparent); backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-text); }
      .merk { font-family: var(--font-heading); font-size: 20px; letter-spacing: 0.02em;
        text-transform: uppercase; white-space: nowrap; color: var(--color-text); }
      .balk nav { display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap;
        font-family: var(--font-heading); font-size: 14px; letter-spacing: 0.09em; text-transform: uppercase; }
      .balk nav a { color: var(--color-text); }
      .burger { display: none; border-radius: 0; width: 46px; height: 42px; flex-direction: column; gap: 5px; padding: 0; }
      .burger span { display: block; width: 20px; height: 1.5px; background: var(--color-text); }

      /* Onder 820 px vouwt de navigatie weg achter de hamburger. */
      @media (max-width: 820px) {
        .burger { display: inline-flex; }
        .balk nav { display: none; flex-direction: column; align-items: stretch; font-size: 18px;
          position: absolute; top: 100%; left: 0; right: 0; z-index: 50; background: var(--color-bg);
          border-bottom: 1px solid var(--color-text); padding: 10px clamp(16px, 4vw, 32px) 16px; }
        .balk nav a { padding: 12px 0; }
        .balk[data-open] nav { display: flex; }
      }

      .voet { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap;
        padding: 20px clamp(16px, 4vw, 32px); font-size: 12.5px; letter-spacing: 0.08em;
        text-transform: uppercase; color: color-mix(in srgb, var(--color-text) 65%, transparent); }
      .voet a { color: inherit; }
    </style>
  </head>
  <body>
    <header class="balk" id="balk">
      <a class="merk" href="/">ziekte <span style="color: var(--color-accent)">⇔</span> werk</a>
      <button class="btn btn-secondary burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav id="hoofdnav">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    </header>

    <slot />

    <footer class="voet">
      <span>ziekte ⇔ werk — uitgesproken als "ziekte als werk"</span>
      <span>Voortgekomen uit <a href="https://philippinehoegen-com.vercel.app/">Performing Working</a>, Philippine Hoegen</span>
      <a href="/luister/feed.xml">Podcastfeed</a>
    </footer>

    <script is:inline>
      (() => {
        const balk = document.getElementById("balk");
        const knop = document.getElementById("burger");
        const nav = document.getElementById("hoofdnav");
        const zet = (open) => {
          balk.toggleAttribute("data-open", open);
          knop.setAttribute("aria-expanded", String(open));
        };
        knop.addEventListener("click", () => zet(!balk.hasAttribute("data-open")));
        // Pas sluiten ná de klik: haal je het menu er meteen onder weg, dan
        // volgt de browser de link niet meer op.
        nav.addEventListener("click", (e) => {
          if (e.target.closest("a")) setTimeout(() => zet(false), 0);
        });
        addEventListener("resize", () => { if (innerWidth >= 820) zet(false); });
      })();
    </script>
  </body>
</html>
