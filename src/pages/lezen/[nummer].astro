---
import Basis from "../../layouts/Basis.astro";
import { getCollection } from "astro:content";
import { readFile } from "node:fs/promises";

export async function getStaticPaths() {
  const nummers = await getCollection("nummers");
  return nummers.map((n) => ({
    params: { nummer: String(n.data.nummer) },
    props: { nummer: n }
  }));
}

const { nummer } = Astro.props;
const n = nummer.data;

// De tekstlaag komt uit het bestand dat scripts/render-pdf.mjs maakte.
// Hij wordt hier meegegeven aan de lezer, zodat er in de browser geen PDF
// meer geladen hoeft te worden.
const tekst = JSON.parse(
  await readFile(`./public/pagina/${n.nummer}/tekst.json`, "utf8").catch(() => "[]")
);
const paginas = Array.from({ length: n.paginas }, (_, i) => i + 1);
---

<Basis titel={`Nummer ${n.nummer} online lezen`}>
  <div
    id="lezer"
    data-nummer={n.nummer}
    data-paginas={n.paginas}
    data-tekst={JSON.stringify(tekst)}
    style="display: flex; flex-direction: column; height: calc(100dvh - 58px); overflow: hidden"
  >
    <div style="display: flex; align-items: center; gap: 10px; padding: 8px clamp(14px, 3vw, 20px); border-bottom: 1px solid var(--color-divider); flex-wrap: wrap">
      <button class="btn btn-secondary btn-icon" data-vorige aria-label="Vorige pagina" style="border-radius: 0">‹</button>
      <span data-teller style="font-size: 14px; font-variant-numeric: tabular-nums">1 van {n.paginas}</span>
      <button class="btn btn-secondary btn-icon" data-volgende aria-label="Volgende pagina" style="border-radius: 0">›</button>
      <a class="btn btn-ghost" href={n.pdf} download style="margin-left: auto">PDF downloaden</a>
      {n.artikelen.length > 0 && <a class="btn btn-ghost" href={`/luister/${n.nummer}`}>Beluisteren</a>}
    </div>

    <div style="flex: 1; display: flex; min-height: 0">
      <aside data-rail style="flex: 0 0 clamp(112px, 20vw, 176px); border-right: 1px solid var(--color-divider); overflow-y: auto; padding: 12px; background: var(--color-surface)">
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px">
          {paginas.map((p) => (
            <button data-ga={p} style="padding: 0; border: 1px solid var(--color-divider); background: #fff; cursor: pointer; display: block">
              <img src={`/pagina/${n.nummer}/p${String(p).padStart(2, "0")}.jpg`} alt="" loading="lazy" width="140" height="198" style="width: 100%; display: block" />
            </button>
          ))}
        </div>
      </aside>

      <main style="flex: 1; min-width: 0; overflow: auto; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(12px, 3vw, 24px); background: var(--color-surface)">
        <div data-spread style="display: flex; gap: 16px; align-items: flex-start; margin: 0 auto; width: max-content"></div>
      </main>
    </div>
  </div>

  <script>
    // De lezer: spreads zoals in het gedrukte nummer (omslag alleen, dan 2|3),
    // een onzichtbare tekstlaag om te selecteren, en de leespositie onthouden.
    import { start } from "../../scripts/lezer.js";
    start(document.getElementById("lezer"));
  </script>
</Basis>
