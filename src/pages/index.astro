---
import Basis from "../layouts/Basis.astro";
import { getCollection, getEntry, render } from "astro:content";

const nummers = (await getCollection("nummers")).sort((a, b) => b.data.nummer - a.data.nummer);
const nieuws = (await getCollection("nieuws")).sort((a, b) => b.data.datum - a.data.datum).slice(0, 3);
const ingesproken = nummers.some((n) => n.data.artikelen.some((a) => a.audio));

// De twee vaste teksten, bewerkbaar via /admin → Vaste teksten.
// De lopende tekst staat in de body van het bestand.
const overEntry = await getEntry("pagina", "over");
const contactEntry = await getEntry("pagina", "contact");
const over = overEntry.data;
const contact = contactEntry.data;
const { Content: OverTekst } = await render(overEntry);
const { Content: ContactTekst } = await render(contactEntry);

const tekst = Object.fromEntries(
  await Promise.all(nieuws.map(async (b) => [b.id, (await render(b)).Content]))
);

const maand = (d) =>
  d.toLocaleDateString("nl-NL", { month: "short", year: "numeric" }).replace(".", "");
---


<Basis titel="COLLECTIEF ZIEKTE⇔WERK: WIE WE ZIJN EN WAT WE DOEN">
  <section id="top" style="padding: clamp(36px, 8vw, 64px) clamp(16px, 4vw, 32px) 40px; border-bottom: 1px solid var(--color-text)">
    <div style="display: flex; justify-content: space-between; gap: 24px; font-family: var(--font-heading); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700); margin-bottom: 28px">
      <span>COLLECTIEF ZIEKTE  WERK: WIE WE ZIJN EN WAT WE DOEN</span>
      <span>Uitgesproken als "ziekte als werk"</span>
    </div>
    <h1 style="font-size: clamp(56px, 12vw, 184px); line-height: 0.86; letter-spacing: -0.03em; text-transform: lowercase; margin: 0 0 28px; max-width: 15ch">
      ziekte <span style="color: var(--color-accent)">⇔</span> werk
    </h1>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(1fr, 1fr)); gap: 24px; align-items: end; border-top: 1px solid var(--color-divider); padding-top: 20px">
      <p style="font-size: 21px; line-height: 1.35; margin: 0; text-wrap: pretty">
        Leven met ziekte is hard werken. Het vraagt vaardigheden, kost moeite en veel tijd. Dat werk doe je zonder voorbereiding, erkenning en in onzichtbaarheid. Ziekte ⇔ Werk stelt de vraag: wat levert het op als we leven met ziekte bekijken door de lens van werk? Wat kunnen we dan zeggen over de vaardigheden die je ontwikkelt, hoe dat werk er uitziet en wat hij bijdraagt aan een groter context?
      </p>
    </div>
    <h4>Test</h4>
  </section>

  <section id="publicaties" style="border-bottom: 1px solid var(--color-text); padding: 44px 0 48px">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding: 0 clamp(16px, 4vw, 32px) 24px; flex-wrap: wrap">
      <div>
        <h6 style="color: var(--color-accent-700); margin: 0 0 12px">01 — Publicaties</h6>
        <h2 style="font-size: clamp(30px, 4vw, 50px); line-height: 1.02; margin: 0; max-width: 22ch">Onze publicaties zover</h2>
      </div>
      <div style="display: flex; align-items: center; gap: 14px">
        <span style="font-size: 12.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent-700)">Sleep of scroll →</span>
        <button class="btn btn-secondary btn-icon" data-strip="-360" style="border-radius: 0" aria-label="Vorige">‹</button>
        <button class="btn btn-secondary btn-icon" data-strip="360" style="border-radius: 0" aria-label="Volgende">›</button>
      </div>
    </div>

    <div id="strip" style="display: flex; gap: 24px; padding: 4px clamp(16px, 4vw, 32px) 20px; overflow-x: auto; scrollbar-width: thin; cursor: grab; scroll-behavior: smooth">
      {nummers.map((n) => (
        <article class="blueprint" style="flex: 0 0 min(320px, 78vw); display: flex; flex-direction: column; padding: 0; border-radius: 0">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <a href={`/lezen/${n.data.nummer}`} style="display: block; text-decoration: none; color: inherit">
            <div style="position: relative; aspect-ratio: 3 / 4; border-bottom: 1px solid var(--color-text); overflow: hidden; background: var(--color-bg)">
              <img src={n.data.omslag} alt={`Omslag nummer ${n.data.nummer}`} loading="lazy"
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center" />
            </div>
            <div style="padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 8px; min-height: 168px">
              <div style="display: flex; gap: 8px; align-items: center">
                <span class="tag tag-outline" style="border-radius: 0">{n.data.status}</span>
                <span style="font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700)">
                  {n.data.jaar} · {n.data.paginas} p.
                </span>
              </div>
              <div style="font-family: var(--font-heading); font-size: 26px; line-height: 1.05">{n.data.titel}</div>
              {n.data.ondertitel && (
                <p style="font-size: 14.5px; line-height: 1.5; margin: 0; color: color-mix(in srgb, var(--color-text) 78%, transparent)">{n.data.ondertitel}</p>
              )}
              <span style="margin-top: auto; font-family: var(--font-heading); font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700)">Lees online →</span>
            </div>
          </a>
        </article>
      ))}

      <article style="flex: 0 0 min(260px, 70vw); display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 22px; border: 1px dashed var(--color-divider)">
        <div style="font-family: var(--font-heading); font-size: 26px; line-height: 1.05">Tijdschriften serie “Ziekte ⇔ Werk”</div>
        <p style="font-size: 14.5px; line-height: 1.5; margin: 0; color: color-mix(in srgb, var(--color-text) 70%, transparent)">
          Binnenkort hier te vinden.
        </p>
      </article>
    </div>

    <div style="display: flex; gap: 28px; flex-wrap: wrap; padding: 0 clamp(16px, 4vw, 32px)">
      <a href="/publicaties" style="font-family: var(--font-heading); font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase">Alle publicaties →</a>
      {ingesproken && (
        <a href="/publicaties" style="font-family: var(--font-heading); font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase">Elk artikel is ook ingesproken — luister mee →</a>
      )}
    </div>
  </section>

  <section id="varia" style="border-bottom: 1px solid var(--color-text)">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr))">
      <div style="padding: clamp(28px, 6vw, 44px) clamp(16px, 4vw, 32px); border-right: 1px solid var(--color-text)">
        <h6 style="color: var(--color-accent-700); margin: 0 0 12px">02 — Varia</h6>
        <h2 style="font-size: clamp(30px, 4vw, 50px); line-height: 1.02; margin: 0 0 26px">Berichten en aankondigingen</h2>
        <div style="display: grid; gap: 1px; background: var(--color-divider); border: 1px solid var(--color-divider)">
          {nieuws.map((b) => {
            const Inhoud = tekst[b.id];
            return (
              <article style="background: var(--color-bg); padding: 20px; display: grid; grid-template-columns: minmax(78px, auto) minmax(0, 1fr); gap: 14px">
                <div style="font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent-700)">{maand(b.data.datum)}</div>
                <div>
                  <h3 style="font-size: 24px; line-height: 1.08; margin: 0 0 6px">{b.data.titel}</h3>
                  <div style="font-size: 14.5px; line-height: 1.55; color: color-mix(in srgb, var(--color-text) 76%, transparent)"><Inhoud /></div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

          <button id="lees-voor" class="btn btn-secondary" style="border-radius: 0">▶ Voorlezen</button>
          <button id="stop-lezen" class="btn btn-secondary" style="border-radius: 0">■ Stop</button>
  <section id="over" style="border-bottom: 1px solid var(--color-text)">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); align-items: stretch">
      <div style="padding: clamp(28px, 6vw, 44px) clamp(16px, 4vw, 32px); border-right: 1px solid var(--color-text)">
        <h6 style="color: var(--color-accent-700); margin: 0 0 24px">03 — Over ons</h6>
        <h2 style="font-size: clamp(32px, 4vw, 54px); line-height: 1.02; margin: 0 0 24px">
          {over.titel}
        </h2>
        <div class="over-tekst" style="font-size: 15.5px; line-height: 1.6">
          <OverTekst />
        </div>
      </div>

      <figure class="blueprint" style="position: relative; margin: 0; border: 0; min-height: min(520px, 78vw)">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <div style="position: absolute; inset: 0">
          <img src={over.foto} alt={over.fotobijschrift ?? ""} onerror="this.style.display='none'" style="width: 100%; height: 100%; object-fit: cover" />
        </div>
        {over.fotobijschrift && (
          <figcaption style="position: absolute; left: 14px; bottom: 12px; z-index: 3; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-bg); mix-blend-mode: difference">
            {over.fotobijschrift}
          </figcaption>
        )}
      </figure>
    </div>
  </section>

  <section id="contact" style="background: var(--color-accent-900); color: var(--color-bg); padding: clamp(36px, 7vw, 56px) clamp(16px, 4vw, 32px) 44px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px">
      <div>
        <h6 style="color: var(--color-accent-300); margin: 0 0 14px">04 — Contact</h6>
        <h2 style="font-size: clamp(34px, 5vw, 68px); line-height: 0.98; margin: 0 0 20px; max-width: 14ch; color: var(--color-bg)">{contact.titel}</h2>
        <div class="contacttekst" style="font-size: 17px; line-height: 1.5; max-width: 40ch; color: color-mix(in srgb, #fff 82%, transparent)">
          <ContactTekst />
        </div>
      </div>

      <!--
      <div class="blueprint" style="padding: 24px; border-color: color-mix(in srgb, #fff 34%, transparent); border-radius: 0">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        {/*
          Een statische site kan zelf geen mail versturen. Vul in /admin → Vaste
          teksten → Contact het adres van een formulierdienst in (Formspree,
          Web3Forms). Laat je het leeg, dan verdwijnt het formulier en blijft
          alleen het e-mailadres staan — dat gaat nooit stuk.
        */}
        {contact.formulier ? (
        <form action={contact.formulier} method="POST" style="display: grid; gap: 14px">
          <div class="field">
            <label style="color: color-mix(in srgb, #fff 75%, transparent)" for="naam">Naam</label>
            <input class="input" id="naam" name="naam" required style="border-radius: 0; background: transparent; color: #fff; border-color: color-mix(in srgb, #fff 34%, transparent)" />
          </div>
          <div class="field">
            <label style="color: color-mix(in srgb, #fff 75%, transparent)" for="email">E-mail</label>
            <input class="input" id="email" type="email" name="email" required style="border-radius: 0; background: transparent; color: #fff; border-color: color-mix(in srgb, #fff 34%, transparent)" />
          </div>
          <div class="field">
            <label style="color: color-mix(in srgb, #fff 75%, transparent)" for="bericht">Waar gaat het over?</label>
            <textarea class="input" id="bericht" name="bericht" required placeholder="Schrijf zoveel of zo weinig als je wilt." style="border-radius: 0; background: transparent; color: #fff; border-color: color-mix(in srgb, #fff 34%, transparent)"></textarea>
          </div>
          <button class="btn btn-primary" type="submit" style="border-radius: 0; background: var(--color-bg); color: var(--color-accent-900)">Versturen</button>
        </form>
        ) : (
          <p style="margin: 0; font-size: 16px; line-height: 1.55; color: color-mix(in srgb, #fff 82%, transparent)">
            Schrijf ons gerust een mail — we lezen alles.
          </p>
        )}
      </div>
     -->
    </div>
  </section>

  <style>
    /* De tekst van "Over ons" komt als één markdown-body binnen en wordt
       hier over twee kolommen verdeeld — geen twee losse velden meer. */
    .kolommen { columns: 2; column-gap: 26px; }
    .kolommen > :first-child { margin-top: 0; }
    .kolommen p { break-inside: avoid; margin: 0 0 1em; }
    @media (max-width: 720px) { .kolommen { columns: 1; } }

    .contacttekst > :first-child { margin-top: 0; }
    .contacttekst > :last-child { margin-bottom: 0; }
    /* Een e-mailadres als losse alinea wordt vanzelf het grote adres. */
    .contacttekst a { color: var(--color-bg); text-decoration: none; border-bottom: 1px solid var(--color-accent-400); }
    .contacttekst p:has(> a:only-child) {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3vw, 38px);
      line-height: 1.1;
      margin-top: 26px;
    }
  </style>

  <script is:inline>
    // De publicatiestrip: slepen met de muis, en de pijltjesknoppen ernaast.
    (() => {
      const strip = document.getElementById("strip");
      if (!strip) return;
      document.querySelectorAll("[data-strip]").forEach((b) =>
        b.addEventListener("click", () => strip.scrollBy({ left: Number(b.dataset.strip), behavior: "smooth" }))
      );
      strip.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return;
        const x0 = e.pageX, s0 = strip.scrollLeft;
        let bewogen = false;
        strip.style.cursor = "grabbing";
        strip.style.scrollBehavior = "auto";
        const beweeg = (ev) => {
          const d = ev.pageX - x0;
          if (Math.abs(d) > 4) bewogen = true;
          strip.scrollLeft = s0 - d;
        };
        const los = (ev) => {
          removeEventListener("mousemove", beweeg);
          removeEventListener("mouseup", los, true);
          strip.style.cursor = "grab";
          strip.style.scrollBehavior = "smooth";
          if (bewogen) { ev.preventDefault(); ev.stopPropagation(); }
        };
        addEventListener("mousemove", beweeg);
        addEventListener("mouseup", los, true);
      });
    })();
  </script>

  <script>

  import { speak, stop, getVoicesFor } from "../scripts/speak.js";

  // Resolve voices once, at load — not inside the click handler.
  let stem = null;
  getVoicesFor("nl").then((v) => {
    console.log("gotVoices",v);
    const google = v.filter(n=>/Google/.test(n.name))
    console.log(google);
    stem = google[0] ?? v[0] ?? null;
    if (!stem) console.warn("Geen Nederlandse stem beschikbaar op dit systeem.");
  });

  document.getElementById("lees-voor")?.addEventListener("click", () => {
    const bron = document.querySelector("#over .over-tekst");
    if (!bron) return console.error("Bron voor voorlezen niet gevonden.");
    speak(bron.innerText, { voice: stem }).catch((e) => console.error("TTS:", e));
  });

  document.getElementById("stop-lezen")?.addEventListener("click", stop);  
</script>

</Basis>
