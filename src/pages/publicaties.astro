---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const nummers = (await getCollection("nummers")).sort((a, b) => a.data.nummer - b.data.nummer);
const klok = (s = 0) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;
const ingesproken = nummers.some((n) => n.data.artikelen.some((a) => a.audio));
---

<Basis titel="Publicaties">
  <section style="padding: clamp(34px, 7vw, 56px) clamp(16px, 4vw, 32px) 36px; border-bottom: 1px solid var(--color-text)">
    <h6 style="color: var(--color-accent-700); margin: 0 0 18px">Publicaties</h6>
    <!--
    <h1 style="font-size: clamp(44px, 8vw, 120px); line-height: 0.9; letter-spacing: -0.03em; text-transform: lowercase; margin: 0 0 22px; max-width: 16ch">
      alles wat we tot nu toe maakten
    </h1>
    <p style="font-size: 19px; line-height: 1.4; max-width: 46ch; margin: 0">
      Elk nummer is gratis online te lezen en te downloaden als PDF. Wil je een papieren
      exemplaar, of kun je het niet betalen? Mail ons — dan sturen we er een op.
    </p>
    {ingesproken && (
      <p style="font-size: 15px; margin: 16px 0 0">
        De artikelen zijn ook ingesproken — klap een nummer open om te luisteren, of
        <a href="/luister/feed.xml"> voeg de podcastfeed toe aan je app</a>.
      </p>
    )}
  </section>

  <section style="padding: 0 clamp(16px, 4vw, 32px) 48px">
   -->
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 28px 0 14px">
      <h2 style="font-size: clamp(24px, 3vw, 34px); margin: 0">Alle nummers</h2>
      <span style="font-size: 12.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent-700)">Klap open voor de artikelen</span>
    </div>

    <div style="border-top: 1px solid var(--color-text)">
      {nummers.map((n) => (
        <details name="nummer" open="true" style="border-bottom: 1px solid var(--color-divider)">
          <summary style="list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: baseline; padding: 18px 4px">
            <span style="flex: 0 0 42px; font-family: var(--font-heading); font-size: 22px; color: var(--color-accent-700)">{String(n.data.nummer).padStart(2, "0")}</span>
            <span style="flex: 2 1 240px; min-width: 0">
              <span style="display: block; font-family: var(--font-heading); font-size: 26px; line-height: 1.05">{n.data.titel}</span>
              <span style="display: block; font-size: 13.5px; color: color-mix(in srgb, var(--color-text) 68%, transparent)">
                {n.data.jaar} · {n.data.paginas} p.
                {n.data.artikelen.length > 0 && ` · ${n.data.artikelen.length} artikel(en)`}
              </span>
            </span>
            <span style="margin-left: auto; display: flex; gap: 14px; flex-wrap: wrap; font-family: var(--font-heading); font-size: 13.5px; letter-spacing: 0.08em; text-transform: uppercase">
              <a href={`/lezen/${n.data.nummer}`}>
                <img src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%0A%3E%3Cpath d='M12 4c4.29 0 7.863 2.429 10.665 7.154l.22 .379l.045 .1l.03 .083l.014 .055l.014 .082l.011 .1v.11l-.014 .111a.992 .992 0 0 1 -.026 .11l-.039 .108l-.036 .075l-.016 .03c-2.764 4.836 -6.3 7.38 -10.555 7.499l-.313 .004c-4.396 0 -8.037 -2.549 -10.868 -7.504a1 1 0 0 1 0 -.992c2.831 -4.955 6.472 -7.504 10.868 -7.504zm0 5a3 3 0 1 0 0 6a3 3 0 0 0 0 -6z' /%3E%3C/svg%3E%0A" />
              </a>
              <a href={n.data.pdf} download>
                <img src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%0A%3E%3Cpath d='M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2' /%3E%3Cpath d='M7 11l5 5l5 -5' /%3E%3Cpath d='M12 4l0 12' /%3E%3C/svg%3E" />
              </a>
            </span>
            
            <!-- 
             <span aria-hidden="true" data-pijl style="flex: 0 0 auto; font-family: var(--font-heading); font-size: 20px; color: var(--color-accent-700); width: 18px; text-align: center">+</span>
             -->
          </summary>

          <div style="padding: 0 4px 22px">
            {n.data.artikelen.length === 0 ? (
              <p style="font-size: 14.5px; margin: 0 0 4px; color: color-mix(in srgb, var(--color-text) 70%, transparent)">
                Van dit nummer zijn geen losse artikelen ontsloten — lees het online of download de PDF.
              </p>
            ) : (
              <div style="border-top: 1px solid var(--color-divider)">
                {n.data.artikelen.map((a) => (
                  <article style="display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; padding: 14px 2px; border-bottom: 1px solid var(--color-divider)">
                    <span style="flex: 0 0 42px; font-family: var(--font-heading); font-size: 15px; color: var(--color-accent-700)">{String(n.data.nummer).padStart(2, "0")}-{a.n}</span>
                    <div style="flex: 2 1 220px; min-width: 0">
                      <div style="font-family: var(--font-heading); font-size: 21px; line-height: 1.1">
                        {a.audio
                          ? <a href={`/luister/${n.data.nummer}-${a.n}`} style="color: inherit">{a.titel}</a>
                          : a.titel}
                      </div>
                      <div style="font-size: 13.5px; color: color-mix(in srgb, var(--color-text) 68%, transparent)">
                        {a.auteur}{a.lezer && ` · gelezen door ${a.lezer}`}
                      </div>
                    </div>
                    <img onclick={`document.getElementById('${n.data.nummer}-${a.n}').play()`} src="data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%0A%3E%3Cpath d='M6 10a7 7 0 1 1 13 3.6a10 10 0 0 1 -2 2a8 8 0 0 0 -2 3a4.5 4.5 0 0 1 -6.8 1.4' /%3E%3Cpath d='M10 10a3 3 0 1 1 5 2.2' /%3E%3C/svg%3E"/>
                    {a.audio ? (
                      <audio id={`${n.data.nummer}-${a.n}`} controls preload="none" src={a.audio} style="flex: 1 1 250px; height: 36px; min-width: 0"></audio>
                    ) : (
                      <span style="flex: 1 1 250px; font-size: 13.5px; color: color-mix(in srgb, var(--color-text) 58%, transparent)">Opname volgt</span>
                    )}
                    {a.duur && <span style="font-size: 13.5px; font-variant-numeric: tabular-nums; flex: 0 0 auto">{klok(a.duur)}</span>}
                  </article>
                ))}
              </div>
            )}
          </div>
        </details>
      ))}
    </div>

    <p style="margin-top: 40px; font-size: 17px">
      Vragen over bestellen of rechten? <a href="/#contact">Neem contact op</a>.
    </p>
  </section>

  <style>
    /* Het eigen driehoekje van de browser weg; wij tonen + en −. */
    /*
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: var(--color-accent-100); }
    summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
    details[open] > summary [data-pijl]::after { content: "−"; }
    details:not([open]) > summary [data-pijl]::after { content: "+"; }
    [data-pijl] { font-size: 0; }
    [data-pijl]::after { font-size: 20px; }
     */
  </style>
</Basis>
