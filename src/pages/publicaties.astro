---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const nummers = (await getCollection("nummers")).sort((a, b) => a.data.nummer - b.data.nummer);
---

<Basis titel="Publicaties">
  <section style="padding: clamp(34px, 7vw, 56px) clamp(16px, 4vw, 32px) 36px; border-bottom: 1px solid var(--color-text)">
    <h6 style="color: var(--color-accent-700); margin: 0 0 18px">Publicaties</h6>
    <h1 style="font-size: clamp(44px, 8vw, 120px); line-height: 0.9; letter-spacing: -0.03em; text-transform: lowercase; margin: 0 0 22px; max-width: 16ch">
      alles wat we tot nu toe maakten
    </h1>
    <p style="font-size: 19px; line-height: 1.4; max-width: 46ch; margin: 0">
      De tijdschriften zijn op diverse plekken te vinden. Mail ons om te weten waar. Elk nummer is ook gratis online te lezen en te downloaden als PDF.
    </p>
  </section>

  <section style="padding: 0 clamp(16px, 4vw, 32px) 48px">
    <div style="overflow-x: auto; margin-top: 20px">
      <table class="table" style="width: 100%; min-width: 640px">
        <thead>
          <tr><th>Nr.</th><th>Titel</th><th>Jaar</th><th>Omvang</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          {nummers.map((n) => (
            <tr>
              <td style="font-family: var(--font-heading); font-size: 18px">{String(n.data.nummer).padStart(2, "0")}</td>
              <td style="font-family: var(--font-heading); font-size: 20px">{n.data.titel}</td>
              <td>{n.data.jaar}</td>
              <td>{n.data.paginas} p.</td>
              <td><span class="tag tag-outline" style="border-radius: 0">{n.data.status}</span></td>
              <td style="text-align: right; white-space: nowrap">
                <a href={`/lezen/${n.data.nummer}`} style="font-family: var(--font-heading); letter-spacing: 0.08em; text-transform: uppercase">Lees online</a>
                {n.data.artikelen.length > 0 && (
                  <>
                    <span style="opacity: 0.4">·</span>
                    <a href={`/luister/${n.data.nummer}`} style="font-family: var(--font-heading); letter-spacing: 0.08em; text-transform: uppercase">Luister</a>
                  </>
                )}
                <span style="opacity: 0.4">·</span>
                <a href={n.data.pdf} download style="font-family: var(--font-heading); letter-spacing: 0.08em; text-transform: uppercase">PDF</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p style="margin-top: 40px; font-size: 17px">
      Vragen over bestellen of rechten? <a href="/#contact">Neem contact op</a>.
    </p>
  </section>
</Basis>
